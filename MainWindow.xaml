<Window x:Class="FinancialAnalyst.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinancialAnalyst"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="Финансовый Аналитик" Height="900" Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundColor}"
        MinWidth="1200" MinHeight="700"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate x:Key="ComparisonItemTemplate">
            <Grid Margin="4,6" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                               Foreground="#0078D4" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Metrics.Count, StringFormat={}{0} метрик}" FontSize="10"
                               Foreground="#606060"/>
                </StackPanel>
                <Button Grid.Column="1" Width="24" Height="24" Padding="0"
                        Command="{Binding DataContext.DeleteComparisonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="Удалить сравнение">
                    <TextBlock Text="✕" FontSize="11" Foreground="#D32F2F"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DocumentItemTemplate">
            <Grid Margin="4,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="5" Padding="6" Margin="0,0,10,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#EDE7F6"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="Pdf">
                                        <Setter Property="Background" Value="#FFEBEE"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="Word">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsComparison}" Value="True">
                                        <Setter Property="Background" Value="#EDE7F6"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="11" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="🔁"/>
                                    <Setter Property="Foreground" Value="#4527A0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="Pdf">
                                            <Setter Property="Text" Value="PDF"/>
                                            <Setter Property="Foreground" Value="#C62828"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="Word">
                                            <Setter Property="Text" Value="DOC"/>
                                            <Setter Property="Foreground" Value="#1565C0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsComparison}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <Run Text="{Binding FileSizeMb, Mode=OneWay, StringFormat={}{0:F1} МБ}"/>
                                <Run Text=" • "/>
                                <Run Text="{Binding DateAdded, StringFormat={}{0:dd.MM.yyyy}}"/>
                            </TextBlock>
                            <TextBlock FontSize="11" Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsComparison}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="NotProcessed">
                                                <Setter Property="Text" Value="Не обработан"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                <Setter Property="Text" Value="Обработка"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                <Setter Property="Text" Value="Анализ завершён"/>
                                                <Setter Property="Foreground" Value="{StaticResource StatusGood}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding DataContext.DeleteDocumentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}" Width="28" Height="28"
                        Style="{StaticResource ToolbarButtonStyle}" Padding="2" Margin="4,0,0,0"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        ToolTip="Удалить документ">
                    <TextBlock Text="✕" FontSize="12" Foreground="#D32F2F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MetricItemTemplate">
            <Border CornerRadius="6" Padding="12" Margin="0,3" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RawText}" Value="left">
                                <Setter Property="Background" Value="#F1F8E9"/>
                                <Setter Property="BorderBrush" Value="#C5E1A5"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RawText}" Value="right">
                                <Setter Property="Background" Value="#FFF5F5"/>
                                <Setter Property="BorderBrush" Value="#FFCDD2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="14" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RawText}" Value="left">
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RawText}" Value="right">
                                        <Setter Property="Foreground" Value="#C62828"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RawText}" Value="equal">
                                        <Setter Property="Foreground" Value="#606060"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FindingItemTemplate">
            <Border CornerRadius="8" Padding="14" Margin="0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F5F5F5"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="Problem">
                                <Setter Property="Background" Value="#FFF5F5"/>
                                <Setter Property="BorderBrush" Value="#FFCDD2"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="Risk">
                                <Setter Property="Background" Value="#FFFDE7"/>
                                <Setter Property="BorderBrush" Value="#FFE082"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="Positive">
                                <Setter Property="Background" Value="#F1F8E9"/>
                                <Setter Property="BorderBrush" Value="#C5E1A5"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="Recommendation">
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="BorderBrush" Value="#90CAF9"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="Observation">
                                <Setter Property="Background" Value="#F5F5F5"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="Problem">
                                        <Setter Property="Text" Value="ПРОБЛЕМА"/>
                                        <Setter Property="Foreground" Value="#C62828"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="Risk">
                                        <Setter Property="Text" Value="РИСК"/>
                                        <Setter Property="Foreground" Value="#E65100"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="Positive">
                                        <Setter Property="Text" Value="ПОЛОЖИТЕЛЬНО"/>
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="Recommendation">
                                        <Setter Property="Text" Value="РЕКОМЕНДАЦИЯ"/>
                                        <Setter Property="Foreground" Value="#1565C0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="Observation">
                                        <Setter Property="Text" Value="НАБЛЮДЕНИЕ"/>
                                        <Setter Property="Foreground" Value="#616161"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#555"
                               TextWrapping="Wrap" LineHeight="22"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <Border Grid.Row="0" Background="{StaticResource ToolbarBackground}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Button Command="{Binding LoadDocumentCommand}" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" Margin="0,0,6,0" FontSize="14"/>
                            <TextBlock Text="Загрузить"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AnalyzeCommand}" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Margin="0,0,6,0" FontSize="14"/>
                            <TextBlock Text="Анализ"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NewComparisonCommand}" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔁" Margin="0,0,6,0" FontSize="14"/>
                            <TextBlock Text="Сравнить"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ExportButton" Click="ExportButton_Click" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,0,0">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="TXT" Command="{Binding ExportReportCommand}" CommandParameter="txt"/>
                                <MenuItem Header="PDF" Command="{Binding ExportReportCommand}" CommandParameter="pdf"/>
                                <MenuItem Header="Word" Command="{Binding ExportReportCommand}" CommandParameter="word"/>
                                <MenuItem Header="Excel (CSV) - только коэффициенты" Command="{Binding ExportReportCommand}" CommandParameter="csv"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📤" Margin="0,0,6,0" FontSize="14"/>
                            <TextBlock Text="Экспорт"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <Border Visibility="{Binding IsIndexing, Converter={StaticResource BoolToVis}}"
                            Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1"
                            CornerRadius="4" Padding="8,2" Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔄" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding IndexingStatus}" FontSize="11" Foreground="#F57F17"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="10" Foreground="#F57F17" Margin="4,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="({0}/{1})">
                                        <Binding Path="IndexingProgress"/>
                                        <Binding Path="IndexingTotal"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Width="1" Height="24" Background="#E0E0E0" Margin="0,0,8,0" VerticalAlignment="Center"/>

                    <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" Margin="0,0,6,0" FontSize="14"/>
                            <TextBlock Text="Настройки"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenHelpCommand}" Style="{StaticResource ToolbarButtonStyle}" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="❓" Margin="0,0,6,0" FontSize="14"/>
                            <TextBlock Text="Справка"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="350"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="380" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Документы" Style="{StaticResource SectionTitleStyle}" Margin="16,14,16,10"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}"
                             ItemTemplate="{StaticResource DocumentItemTemplate}"
                             BorderThickness="0" Background="Transparent"
                             Margin="4,0,4,4" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Border" Background="Transparent" CornerRadius="6" Padding="4">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#E3F2FD"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#F0F0F0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <Border Grid.Row="2" Margin="10" Padding="10" Background="#F5F5F5" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Сводка" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="{Binding DocumentSummary}" FontSize="11" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>

                            <Separator Margin="0,8" Height="1" Background="#E0E0E0"
                                       Visibility="{Binding HasComparisons, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Text="Сравнения" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"
                                       Foreground="{StaticResource TextSecondary}"
                                       Visibility="{Binding HasComparisons, Converter={StaticResource BoolToVis}}"/>

                            <ListBox ItemsSource="{Binding Comparisons}"
                                     SelectedItem="{Binding SelectedComparison}"
                                     ItemTemplate="{StaticResource ComparisonItemTemplate}"
                                     BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MaxHeight="200">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Border" Background="Transparent"
                                                            CornerRadius="4" Padding="2">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="#E3F2FD"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="#F0F0F0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.Style>
                                    <Style TargetType="ListBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasComparisons}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- GridSplitter 1 -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          ToolTip="Изменить размер панели">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border Width="2" Background="#E0E0E0" HorizontalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </GridSplitter.Template>
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Cursor" Value="SizeWE"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>

            <!-- CENTER - DATA PANEL -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0" Margin="8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,14,16,16">

                        <!-- Normal View (single doc) -->
                        <StackPanel>
                            <!-- Progress -->
                            <Border Padding="12" Background="#F0F7FF" CornerRadius="8" BorderBrush="#D0E3FF" BorderThickness="1" Margin="0,0,0,16"
                                    Visibility="{Binding IsAiProcessing, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding AiStatusText}" FontSize="12" Foreground="{StaticResource AccentColor}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding AiProgress, StringFormat={}{0}%}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    </DockPanel>
                                    <ProgressBar Height="6" Value="{Binding AiProgress}" Maximum="100" Margin="0,6,0,0"
                                                 ValueChanged="ProgressBar_ValueChanged">
                                        <ProgressBar.Template>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Border Background="#E8E8E8" CornerRadius="3" ClipToBounds="True">
                                                    <Border Name="PART_Indicator" Background="{StaticResource AccentColor}" CornerRadius="3" HorizontalAlignment="Left"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ProgressBar.Template>
                                    </ProgressBar>
                                    <!-- Этапы обработки -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="40*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="20*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="20*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Name="Stage1Bar" Height="6" CornerRadius="3" Background="#E0E0E0"/>
                                        <Border Grid.Column="2" Name="Stage2Bar" Height="6" CornerRadius="3" Background="#E0E0E0"/>
                                        <Border Grid.Column="4" Name="Stage3Bar" Height="6" CornerRadius="3" Background="#E0E0E0"/>
                                        <Border Grid.Column="6" Name="Stage4Bar" Height="6" CornerRadius="3" Background="#E0E0E0"/>
                                    </Grid>
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="40*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="20*"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="20*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Текст" FontSize="9" Foreground="#999" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="AI-извлечение" FontSize="9" Foreground="#999" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="Расчёт" FontSize="9" Foreground="#999" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="AI-анализ" FontSize="9" Foreground="#999" TextAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowComparisonView}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                            <!-- Financial Ratios -->
                            <TextBlock Text="Финансовые коэффициенты" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                            <WrapPanel Margin="0,0,0,16">
                                <!-- ROE -->
                                <Border Width="170">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource RatioCardStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FinancialRatios.RoeStatus}" Value="Good">
                                                    <Setter Property="BorderBrush" Value="#C6F6D5"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FinancialRatios.RoeStatus}" Value="Normal">
                                                    <Setter Property="BorderBrush" Value="#FEFCBF"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FinancialRatios.RoeStatus}" Value="Bad">
                                                    <Setter Property="BorderBrush" Value="#FED7D7"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="ROE" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="18" FontWeight="Bold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Н/Д"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FinancialRatios.RoeStatus}" Value="Good">
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FinancialRatios.RoeStatus}" Value="Normal">
                                                            <Setter Property="Foreground" Value="#F9A825"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FinancialRatios.RoeStatus}" Value="Bad">
                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:F2}%">
                                                    <Binding Path="FinancialRatios.ROE"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="Рентабельность капитала" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- ROA -->
                                <Border Width="170">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource RatioCardStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FinancialRatios.RoaStatus}" Value="Good">
                                                    <Setter Property="BorderBrush" Value="#C6F6D5"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FinancialRatios.RoaStatus}" Value="Normal">
                                                    <Setter Property="BorderBrush" Value="#FEFCBF"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FinancialRatios.RoaStatus}" Value="Bad">
                                                    <Setter Property="BorderBrush" Value="#FED7D7"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="ROA" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="18" FontWeight="Bold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Н/Д"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FinancialRatios.RoaStatus}" Value="Good">
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FinancialRatios.RoaStatus}" Value="Normal">
                                                            <Setter Property="Foreground" Value="#F9A825"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FinancialRatios.RoaStatus}" Value="Bad">
                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:F2}%">
                                                    <Binding Path="FinancialRatios.ROA"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="Рентабельность активов" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- D/E -->
                                <Border Width="170">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource RatioCardStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FinancialRatios.DebtEquityStatus}" Value="Good">
                                                    <Setter Property="BorderBrush" Value="#C6F6D5"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FinancialRatios.DebtEquityStatus}" Value="Normal">
                                                    <Setter Property="BorderBrush" Value="#FEFCBF"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FinancialRatios.DebtEquityStatus}" Value="Bad">
                                                    <Setter Property="BorderBrush" Value="#FED7D7"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Д/К" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="18" FontWeight="Bold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Н/Д"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FinancialRatios.DebtEquityStatus}" Value="Good">
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FinancialRatios.DebtEquityStatus}" Value="Normal">
                                                            <Setter Property="Foreground" Value="#F9A825"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FinancialRatios.DebtEquityStatus}" Value="Bad">
                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:F2}">
                                                    <Binding Path="FinancialRatios.DebtToEquity"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="Долг / Капитал" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- NIM -->
                                <Border Width="170">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource RatioCardStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FinancialRatios.NimStatus}" Value="Good">
                                                    <Setter Property="BorderBrush" Value="#C6F6D5"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FinancialRatios.NimStatus}" Value="Normal">
                                                    <Setter Property="BorderBrush" Value="#FEFCBF"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FinancialRatios.NimStatus}" Value="Bad">
                                                    <Setter Property="BorderBrush" Value="#FED7D7"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="NIM" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="18" FontWeight="Bold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Н/Д"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FinancialRatios.NimStatus}" Value="Good">
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FinancialRatios.NimStatus}" Value="Normal">
                                                            <Setter Property="Foreground" Value="#F9A825"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FinancialRatios.NimStatus}" Value="Bad">
                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:F2}%">
                                                    <Binding Path="FinancialRatios.NIM"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="Чистая процентная маржа" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- C/I -->
                                <Border Width="170">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource RatioCardStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FinancialRatios.CostIncomeStatus}" Value="Good">
                                                    <Setter Property="BorderBrush" Value="#C6F6D5"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FinancialRatios.CostIncomeStatus}" Value="Normal">
                                                    <Setter Property="BorderBrush" Value="#FEFCBF"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FinancialRatios.CostIncomeStatus}" Value="Bad">
                                                    <Setter Property="BorderBrush" Value="#FED7D7"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="C/I" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="18" FontWeight="Bold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Н/Д"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FinancialRatios.CostIncomeStatus}" Value="Good">
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FinancialRatios.CostIncomeStatus}" Value="Normal">
                                                            <Setter Property="Foreground" Value="#F9A825"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FinancialRatios.CostIncomeStatus}" Value="Bad">
                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:F2}%">
                                                    <Binding Path="FinancialRatios.CostToIncome"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="Отношение затрат к доходам" FontSize="9" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                            </StackPanel>

                            <!-- Pie Charts -->
                            <TextBlock Text="Визуализация структуры" Margin="0,8,0,10">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasChartData}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Capital Structure Pie Chart -->
                            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCapitalStructure}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="Структура капитала" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                    <lvc:PieChart Height="220" Series="{Binding CapitalStructureSeries}" InitialRotation="45"/>
                                </StackPanel>
                            </Border>

                            <!-- Income Distribution Pie Chart -->
                            <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasIncomeData}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="Распределение доходов" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                    <lvc:PieChart Height="220" Series="{Binding IncomeDistributionSeries}" InitialRotation="45"/>
                                </StackPanel>
                            </Border>

                            <!-- Extracted Metrics -->
                            <TextBlock Text="Извлечённые метрики" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding ExtractedMetrics}" ItemTemplate="{StaticResource MetricItemTemplate}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ExtractedMetrics.Count}" Value="0">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate>
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20">
                                                                <TextBlock Text="—" FontSize="28" Foreground="#C0C0C0" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                                <TextBlock Text="Загрузите документ и нажмите" FontSize="13" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="«Анализ» для извлечения данных" FontSize="13" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- GridSplitter 2 -->
            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          ToolTip="Изменить размер панели">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border Width="2" Background="#E0E0E0" HorizontalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </GridSplitter.Template>
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Cursor" Value="SizeWE"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>

            <!-- RIGHT - AI FINDINGS -->
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="0" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Выводы AI" Style="{StaticResource SectionTitleStyle}" Margin="16,14,16,10"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,0,16,16">
                        <ItemsControl ItemsSource="{Binding AiFindings}" ItemTemplate="{StaticResource FindingItemTemplate}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AiFindings.Count}" Value="0">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate>
                                                         <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40">
                                                             <TextBlock Text="—" FontSize="28" Foreground="#C0C0C0" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                             <TextBlock Text="Выводы AI появятся после анализа" FontSize="13" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                                         </StackPanel>
                                                     </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- DEBUG SPLITTER -->
        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                      Background="#1E1E1E" ResizeBehavior="PreviousAndNext"
                      ToolTip="Изменить размер журнала"
                      Visibility="{Binding HasDebugLogs, Converter={StaticResource BoolToVis}}"/>

        <!-- DEBUG PANEL -->
        <Border Grid.Row="3" Background="#1E1E1E" BorderBrush="#333" BorderThickness="0,1,0,0"
                Visibility="{Binding HasDebugLogs, Converter={StaticResource BoolToVis}}"
                IsVisibleChanged="DebugPanel_IsVisibleChanged">
            <Grid MinHeight="120">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="8,4,8,2">
                    <TextBlock Text="Журнал отладки" FontSize="11" FontWeight="SemiBold" Foreground="#888" DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Command="{Binding CopyLogsCommand}" Content="📋 Копировать" FontSize="10" Padding="6,1"
                                Margin="0,0,4,0" HorizontalAlignment="Right"
                                Background="Transparent" BorderBrush="#555" Foreground="#888"/>
                        <Button Command="{Binding ClearDebugCommand}" Content="Очистить" FontSize="10" Padding="4,1"
                                HorizontalAlignment="Right"
                                Background="Transparent" BorderBrush="#555" Foreground="#888"/>
                    </StackPanel>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8,0,8,4"
                              VerticalAlignment="Stretch" MaxHeight="400">
                    <ItemsControl ItemsSource="{Binding DebugLogs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10"
                                           Foreground="#DDD" TextWrapping="NoWrap"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
